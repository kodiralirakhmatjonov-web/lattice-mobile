{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iumrah-hotels-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "iumrah.app/api/admin/hotels*",
      "zone_id": "__ZONE_ID__"
    },
    {
      "pattern": "iumrah.app/api/catalog/hotels*",
      "zone_id": "__ZONE_ID__"
    }
  ],
  "d1_databases": [
    {
      "binding": "HOTELS_DB",
      "database_name": "iumrah-hotels",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HOTELS_MEDIA",
      "bucket_name": "iumrah-hotels-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "name": "iumrah-hotel-import",
      "binding": "HOTEL_IMPORT_WORKFLOW",
      "class_name": "HotelImportWorkflow"
    }
  ],
  "vars": {
    "AUTH_SESSION_URL": "https://iumrah.app/api/auth/staff/session",
    "BOOKINGS_ADMIN_URL": "https://iumrah.app/api/admin/bookings",
    "CLIENT_SESSION_URL": "https://iumrah.app/api/auth/session"
  },
  "images": {
    "binding": "IMAGES"
  }
}
