    "d1_migration_required": false,
    "existing_links_preserved": true,
    "testflight_optional_for_backend_behavior": true,
    "manual_revoke_remains_supported": true,
    "snapshot_id_semantics": "audit/configuration metadata only; not a link-expiry or global apply lock"
  },
