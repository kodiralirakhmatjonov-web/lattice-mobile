{
  "update": "iumrah-business-security-sessions-mac-device-20261004",
  "description": "Telegram-style session termination/re-login, new-login security alerts/banner, and correct iPhone/iPad/Mac Catalyst device identification.",
  "deployment_order": [
    "apply_patch_to_repository_root",
    "deploy_hotels_cloud_migrations_and_worker",
    "build_and_deploy_testflight"
  ],
  "notes": {
    "d1_migration_required": true,
    "remote_termination_behavior": "revokes only the active session; device identity is not permanently blocked",
    "legacy_blocked_devices": "a verified login reactivates devices blocked by the previous policy",
    "passive_restore_after_remote_termination": "denied until the user logs in again",
    "new_login_alerts": "APNs to other active devices plus a 48-hour in-app Overview banner backed by security login events",
    "mac_catalyst_detection": "reports macOS + Mac family/model instead of arm64/iPhone Simulator",
    "validation": [
      "npm run check",
      "node --test tests/business-security-relogin.test.mjs"
    ]
  },
